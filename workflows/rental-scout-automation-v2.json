    {
      "parameters": {
        "jsCode": "const emailText = $input.first().json.text;\n\nconst partes = emailText.split(\"Ver agora\");\n\nconst anuncios = partes.filter(parte => parte.includes(\"Quartos:\"));\n\nreturn anuncios.map(parte => {\n  const quartos = parte.match(/Quartos:\\s*(\\d+)/);\n  const banheiros = parte.match(/Banheiros:\\s*(\\d+)/);\n  const preco = parte.match(/R\\$\\s*([\\d.]+,\\d{2})/);\n\n  // Aceita Florianópolis ou Imbituba\n  const localizacao = parte.match(\n    /\\n\\s*([^\\n]+),\\s*(Florianópolis|Imbituba)\\s*\\n\\s*\\n\\s*([^\\n]+)/\n  );\n\n  const bairro = localizacao ? localizacao[1].trim() : null;\n  const cidade = localizacao ? localizacao[2].trim() : null;\n  const titulo = localizacao ? localizacao[3].trim() : null;\n\n  let tipo_imovel = null;\n\n  if (titulo) {\n    const tituloMinusculo = titulo.toLowerCase();\n\n    if (tituloMinusculo.includes(\"apartamento\")) {\n      tipo_imovel = \"apartamento\";\n    } else if (tituloMinusculo.includes(\"casa\")) {\n      tipo_imovel = \"casa\";\n    }\n  }\n\n  const urls = parte.match(\n    /https:\\/\\/click\\.newsolx\\.com\\.br\\/\\?qs=[^\\]\\)\\s]+/g\n  );\n\n  const url_rastreamento = urls ? urls[urls.length - 1] : null;\n\n  return {\n    json: {\n      titulo,\n      bairro,\n      cidade,\n      quartos: quartos ? Number(quartos[1]) : null,\n      banheiros: banheiros ? Number(banheiros[1]) : null,\n      preco: preco\n        ? Number(preco[1].replace(/\\./g, \"\").replace(\",\", \".\"))\n        : null,\n      tipo_imovel,\n      url_rastreamento\n    }\n  };\n});"
      },
